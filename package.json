{
  "name": "@danbruegge/resume",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build:page": "next build",
    "build:pdf": "node scripts/generate-pdf.mjs",
    "build:docx": "node scripts/generate-docx.mjs",
    "build": "pnpm build:page && pnpm build:pdf && pnpm build:docx",
    "deploy": "sh deploy.sh",
    "start": "next start",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "git rev-parse --is-inside-work-tree > /dev/null 2>&1 && lefthook install || true",
    "postinstall": "npx puppeteer browsers install chrome"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "date-fns": "^4.4.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "19.3.0",
    "autoprefixer": "^10.6.1",
    "html-to-docx": "^1.8.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "postcss": "^8.5.28",
    "puppeteer": "^25.11.0",
    "react-is": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^7.0.2"
  }
}
