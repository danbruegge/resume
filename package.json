{
  "name": "@danbruegge/resume",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build:page": "next build",
    "build:pdf": "node scripts/generate-pdf.mjs",
    "build:docx": "node scripts/generate-docx.mjs",
    "build": "pnpm build:page && pnpm build:pdf && pnpm build:docx",
    "deploy": "sh deploy.sh",
    "start": "next start",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "git rev-parse --is-inside-work-tree > /dev/null 2>&1 && lefthook install || true",
    "postinstall": "npx puppeteer browsers install chrome"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "date-fns": "^4.2.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "19.2.15",
    "autoprefixer": "^10.5.0",
    "html-to-docx": "^1.8.0",
    "lefthook": "^2.1.8",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "postcss": "^8.5.15",
    "puppeteer": "^25.0.4",
    "react-is": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["lefthook"]
  }
}
